---
import { icons } from "./icons";
import type { IconName } from "./icons";

/**
 * Petit jeu d'icônes SVG inline (trait 1,75, viewBox 24). Aucune dépendance.
 * Décoratives par défaut (aria-hidden) ; passer `label` pour une icône porteuse de sens.
 */

interface Props {
  name: IconName;
  /** Taille Tailwind par défaut : size-5. Surchargeable via class. */
  class?: string;
  /** Texte alternatif : si absent, l'icône est décorative. */
  label?: string;
}
const { name, class: className = "size-5", label } = Astro.props;
---

<svg
  class:list={["shrink-0", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={icons[name]}
/>
