---
/** Largeur maximale (72 rem) et marges latérales cohérentes sur tout le site. */
interface Props {
  class?: string;
  /** Largeur réduite pour les contenus de lecture (FAQ, textes) */
  size?: "default" | "narrow";
}
const { class: className, size = "default" } = Astro.props;
---

<div
  class:list={[
    "mx-auto w-full px-5 sm:px-8",
    size === "default" ? "max-w-6xl" : "max-w-3xl",
    className,
  ]}
>
  <slot />
</div>
