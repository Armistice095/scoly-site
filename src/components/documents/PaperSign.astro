---
/**
 * Bloc signature des aperçus : lieu et date, fonction, cachet rond et signature (SVG simples, fictifs), nom.
 * Placé en bas de page par `.pp-bottom` ; les autres éléments du bas (QR, signature du demandeur) vont dans le slot.
 */
import { sample } from "./sample";
---

<div class="pp-bottom">
  <slot />
  <div class="pp-sign">
    <p>Fait à {sample.city}, le {sample.date}</p>
    <p><b>Le Directeur,</b></p>
    <div class="pp-seal">
      <svg class="pp-stamp" viewBox="0 0 60 60" focusable="false" fill="none" stroke="var(--color-brand-700)" opacity="0.8">
        <circle cx="30" cy="30" r="28" stroke-width="1.8"></circle>
        <circle cx="30" cy="30" r="23.5" stroke-width="3.2" stroke-dasharray="1.1 1.9"></circle>
        <circle cx="30" cy="30" r="19" stroke-width="0.8"></circle>
        <path d="M19 26h22M22 31h16M24.5 36h11" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <svg class="pp-sig" viewBox="0 0 100 38" focusable="false" fill="none" stroke="var(--color-brand-800)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 28c9-17 15-22 14-12s-5 14 3 7 9-17 16-13-3 16 7 9 12-14 19-9 7 9 16 3 12-5 18-9"></path>
        <path d="M30 33c17-3 38-4 62-2"></path>
      </svg>
    </div>
    <p class="pp-signname">{sample.student}</p>
  </div>
</div>
