---
/**
 * QR décoratif du certificat de scolarité (l'exemple fourni en comporte un ; les autres types, non).
 * Ce n'est PAS un vrai QR : motif déterministe (3 repères + modules pseudo-aléatoires), qui n'encode
 * rien et ne peut pas être scanné. Il n'y a ni lien ni code de vérification inventé.
 */
const N = 25;
let seed = 7;
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const inFinder = (x: number, y: number) =>
  (x < 8 && y < 8) || (x >= N - 8 && y < 8) || (x < 8 && y >= N - 8);
const rects: string[] = [];
const finder = (ox: number, oy: number) => {
  rects.push(`M${ox} ${oy}h7v7h-7zM${ox + 1} ${oy + 1}v5h5v-5z`); // anneau (règle evenodd)
  rects.push(`M${ox + 2} ${oy + 2}h3v3h-3z`);
};
finder(0, 0);
finder(N - 7, 0);
finder(0, N - 7);
for (let y = 0; y < N; y++) {
  let run = 0;
  for (let x = 0; x <= N; x++) {
    const on = x < N && !inFinder(x, y) && rnd() > 0.52;
    if (on) run++;
    else if (run) {
      rects.push(`M${x - run} ${y}h${run}v1h-${run}z`);
      run = 0;
    }
  }
}
const d = rects.join("");
---

<svg
  viewBox={`0 0 ${N} ${N}`}
  width="15.5cqw"
  height="15.5cqw"
  style="width:15.5cqw;height:15.5cqw;flex:none"
  focusable="false"
  shape-rendering="crispEdges"
>
  <path d={d} fill="var(--color-ink)" fill-rule="evenodd"></path>
</svg>
