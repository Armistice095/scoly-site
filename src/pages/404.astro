---
import Base from "../layouts/Base.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
---

<Base title="Page introuvable — Scoly" description="La page que vous cherchez n’existe pas ou a été déplacée." noindex>
  <Navbar />
  <main id="contenu" tabindex="-1" class="outline-none">
    <Container size="narrow" class="py-24 text-center sm:py-32">
      <p class="type-label text-muted">Erreur 404</p>
      <h1 class="type-h1 mt-4">Page introuvable</h1>
      <p class="type-lead mx-auto mt-5 max-w-md">La page que vous cherchez n’existe pas ou a été déplacée.</p>
      <div class="mt-9">
        <Button href="/" size="lg">Retour à l’accueil</Button>
      </div>
    </Container>
  </main>
  <Footer />
</Base>
